{
  // 정적 SPA + 블로그 글 메타태그 서버사이드 주입용 얇은 Worker.
  // worker/index.js가 /blog, /blog/:slug 요청만 가로채 <head>를 다시 쓰고,
  // 그 외 모든 요청은 그대로 정적 자산(assets)으로 서빙한다.
  "name": "petpedia",
  "compatibility_date": "2026-09-12",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    // 클라이언트 라우팅(/blog, /blog/:slug)을 새로고침하거나 직접 주소로 들어와도
    // index.html로 폴백해 React가 해당 경로를 그려주게 한다.
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/blog", "/blog/*"]
  }
}
